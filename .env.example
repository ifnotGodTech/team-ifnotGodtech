# The backend API's address, used only on the server. Without it, every screen shows that the
# server can't be reached.
DASHBOARD_API_URL=https://api.ifnotgod.com

# The dashboard's own key for the backend, sent with every request. Must match the backend's
# DASHBOARD_APP_KEY. Locally, the backend's is local-dashboard-app-key.
DASHBOARD_APP_KEY=

# Signs the staff session cookie. Required on Vercel; local development uses a built-in one.
DASHBOARD_SESSION_SECRET=
