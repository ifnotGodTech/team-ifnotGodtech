# The backend API's address, used only on the server. Without it, log in shows that the server
# can't be reached. Locally: http://127.0.0.1:8000
DASHBOARD_API_URL=https://api.ifnotgod.com

# The dashboard's own key for the backend, sent with every request. Must match the backend's
# DASHBOARD_APP_KEY. Locally, the backend's is local-dashboard-app-key.
DASHBOARD_APP_KEY=

# Encrypts the staff session cookie, which holds the backend's token. Required on Vercel; local
# development uses a built-in one. Generate with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=
